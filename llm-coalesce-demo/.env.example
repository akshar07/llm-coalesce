# Port the server listens on. Most PaaS providers inject this automatically —
# the app reads process.env.PORT and falls back to 3000 for local dev.
PORT=3000

# Optional. If set, the server streams from the real Anthropic API instead of
# the built-in mock provider. The mock is the default so the demo runs with
# zero setup and zero API cost. This has nothing to do with coalescing —
# it only changes where tokens come from.
#
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
