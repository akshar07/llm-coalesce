{
  "name": "llm-coalesce",
  "version": "0.2.0",
  "description": "Request coalescing and stream multicasting for LLM calls in multi-widget apps — dedupe concurrent completions and share one live token stream across independently-deployed UI code, without a shared module instance.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "keywords": [
    "llm",
    "ai",
    "cache",
    "coalesce",
    "dedupe",
    "streaming",
    "micro-frontend",
    "multicast"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@testing-library/react": "^16.0.0",
    "jsdom": "^24.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshar07/llm-coalesce.git",
    "directory": "llm-coalesce"
  },
  "homepage": "https://github.com/akshar07/llm-coalesce/tree/main/llm-coalesce#readme",
  "bugs": {
    "url": "https://github.com/akshar07/llm-coalesce/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
